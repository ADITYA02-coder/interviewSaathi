# ============================================================================================
# RENDER > your web service > Environment > "Add from .env"  (paste this whole file, then fix the <...> values)
# Works for: Vercel UI + Render API (recommended split)  AND  Render-only (see the notes at the bottom)
# ============================================================================================

# --- 1. Database. Render Postgres > "Connections" > copy the INTERNAL Database URL. Service and database must be in the SAME region.
#     (Using the Blueprint in render.yaml? This one is wired automatically; skip it.)
DATABASE_URL=<paste the Internal Database URL>

# --- 2. Security. Generate with:  python -c "import secrets; print(secrets.token_hex(32))"   (must be 32+ characters)
JWT_SECRET=<paste a 64-character random value>
REQUIRE_STRONG_SECRETS=1

# --- 3. Who is the admin. Register with EXACTLY this email, then open the link printed in Render > Logs (search "DEV EMAIL").
ADMIN_EMAILS=<you@gmail.com>
ADMIN_PASSWORD=<strong-admin-password>

# --- 4. Your web addresses. Fill these AFTER the first deploys (see "order of steps"). No trailing slash, https only.
APP_URL=https://<your-project>.vercel.app
CORS_ORIGINS=https://<your-project>.vercel.app

# --- 5. No email service on the free tier: an admin approves students in Admin > Users.
EMAIL_VERIFICATION=admin

# --- 5b. OPTIONAL real emails (verification links + password reset). Free tier: Brevo on port 2525 (Render blocks 25/465/587 on free instances).
#     To use them also change EMAIL_VERIFICATION=admin above to EMAIL_VERIFICATION=email. Steps: SMTP_SETUP.md
#SMTP_HOST=smtp-relay.brevo.com
#SMTP_PORT=2525
#SMTP_USER=<the Login shown in Brevo > SMTP & API>
#SMTP_PASSWORD=<your Brevo SMTP key>
#SMTP_FROM=InterviewSaathi <your-verified-sender@yourcollege.edu>

# --- 6. Gnani voice (key created with BOTH scopes: Text to Speech and Speech to Text)
GNANI_API_KEY=<your Gnani key>

# --- 7. The interviewer's brain (Groq free tier shown; any OpenAI-compatible service works)
LLM_PROVIDER=openai
OPENAI_API_KEY=<your Groq key, starts with gsk_>
OPENAI_BASE_URL=https://api.groq.com/openai/v1
OPENAI_MODEL=openai/gpt-oss-120b

# ============================================================================================
# Do NOT set: PORT (Render sets it), RUNNER_URL / RUNNER_SECRET (leave empty = coding rounds off). SMTP_* is optional (see 5b).
# Render-ONLY setup (no Vercel): set APP_URL=https://<your-service>.onrender.com and delete the CORS_ORIGINS line.
# ============================================================================================
