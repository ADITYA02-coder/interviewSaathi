# ============================================================================================
# VERCEL > Project > Settings > Environment Variables (paste, tick Production + Preview), then REDEPLOY.
# Project settings: Root Directory = frontend   |   Framework = Vite   |   Build = npm run build   |   Output = dist
# ============================================================================================

# The address of your Render API. No trailing slash. This is PUBLIC: it is baked into the website every visitor downloads.
VITE_API_URL=https://<your-service>.onrender.com

# ============================================================================================
# That is the ONLY variable Vercel needs.
# NEVER add GNANI_API_KEY, OPENAI_API_KEY, JWT_SECRET or any other secret here: they belong on Render only.
# ============================================================================================
