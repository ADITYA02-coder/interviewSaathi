# ===== Deployment (docker compose reads this same file) =====
# Your domain, pointing at the server. HTTPS is automatic. Leave as localhost to try it locally.
DOMAIN=localhost

# ===== Gnani (the voice layer) =====
# Get a key from https://app.gnani.ai/voice or email speechstack@gnani.ai
GNANI_API_KEY=
GNANI_BASE_URL=https://api.vachana.ai
GNANI_TTS_MODEL=timbre-v2.5
# "transcribe" = inverse text normalisation (digits, symbols); "verbatim" = spoken words
GNANI_STT_FORMAT=transcribe
# Live transcription while the candidate speaks (WebSocket). Falls back to one-shot upload automatically.
GNANI_STREAMING=true

# ===== Interview "brain" (any ONE of these; free options are in the README) =====
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== Coding round: the separate sandbox service =====
# docker compose sets these for you. For local development see README ("Run the code runner").
RUNNER_URL=
RUNNER_SECRET=      # REQUIRED for docker compose: openssl rand -hex 16

# ===== Admin and email =====
# Anyone who registers or signs in with one of these addresses becomes an admin (comma separated).
ADMIN_EMAILS=
# How accounts get verified:
#   email = a verification link is emailed (needs SMTP below, or copy the link from the server log)
#   admin = NO email at all: an admin approves students in Admin > Users (best when you have no SMTP, e.g. Render free)
EMAIL_VERIFICATION=email
# Public address of the web app, used in password-reset and verification links.
APP_URL=http://localhost:5173
# Without SMTP the emails are only printed in the server console. Full guide: SMTP_SETUP.md
# Brevo (free 300/day, works on Render's free tier): host smtp-relay.brevo.com, port 2525, user = the Login on Brevo's SMTP page, password = SMTP key
# Gmail: host smtp.gmail.com, port 587, user = your Gmail, password = an App Password (blocked on Render's free tier)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
# The sender address MUST be verified at your provider. Gmail always sends as your own address.
SMTP_FROM=InterviewSaathi <no-reply@yourcollege.edu>
# starttls (ports 587/2525, default) | ssl (port 465, chosen automatically) | none (local debug servers only)
SMTP_SECURITY=

# ===== App =====
JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./interviewsaathi.db
CORS_ORIGINS=http://localhost:5173
